<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.egovframe.boot</groupId>
		<artifactId>egovframe-boot-starter-parent</artifactId>
		<version>5.1.0</version>
		<relativePath/>
	</parent>
	
	<groupId>com.example</groupId>
	<artifactId>egovframe-webflux-mcp</artifactId>
	<version>1.0.0</version>
	<name>egovframe-webflux-mcp</name>
	<description>egovframe webflux MCP Server Sample</description>

	<properties>
		<java.version>17</java.version>
		<!--
			DJL PyTorch 네이티브 버전.
			spring-ai-transformers가 끌어오는 pytorch-engine 버전과 반드시 맞춰야 한다.
			현재: spring-ai-transformers 1.1.8 → ai.djl.pytorch:pytorch-engine:0.32.0 → PyTorch 2.5.1
			Spring AI 업그레이드 시 이 두 값도 함께 확인할 것.
		-->
		<djl.version>0.32.0</djl.version>
		<djl.pytorch.version>2.5.1</djl.pytorch.version>
	</properties>

	<repositories>
		<repository>
			<id>mvn2s</id>
			<url>https://repo1.maven.org/maven2/</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>true</enabled>
			</snapshots>
		</repository>
		<repository>
			<id>egovframe2</id>
			<url>https://maven.egovframe.go.kr/maven/</url>
			<releases>
				<enabled>true</enabled>
			</releases>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>

	<dependencies>
		<!-- 표준프레임워크 실행환경 -->
		<dependency>
			<groupId>org.egovframe.rte</groupId>
			<artifactId>egovframe-rte-fdl-cmmn</artifactId>
		</dependency>

		<!-- Spring AI MCP Server WebFlux (Reactive) -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-mcp-server-webflux</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- PGVector 벡터 저장소 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
		</dependency>

		<!-- ONNX 임베딩 모델 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-starter-model-transformers</artifactId>
		</dependency>

		<!--
			DJL PyTorch 네이티브 라이브러리 (폐쇄망 대응)

			임베딩을 하려면 libtorch(torch_cpu.dll 등)가 필요하다. 
			인터넷이 되는 환경이면 spring-ai-transformers가 데려오는 
			pytorch-engine 안의 코드(LibUtils)가 임베딩 시점에 직접 받아 온다.

			임베딩 시점에 인터넷이 안 되는 환경이면 이 이슈 때문에 실패하므로
			DJL PyTorch 네이티브 라이브러리를 직접 선언해야 한다.
			
			classifier는 아래 프로파일이 '빌드하는 OS' 기준으로 자동 결정한다.
			빌드 OS와 배포 OS가 다르면 명령행에서 직접 지정할 것:
			mvn package -Ddjl.pytorch.classifier=linux-x86_64
		-->
		<dependency>
			<groupId>ai.djl.pytorch</groupId>
			<artifactId>pytorch-native-cpu</artifactId>
			<version>${djl.pytorch.version}</version>
			<classifier>${djl.pytorch.classifier}</classifier>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>ai.djl.pytorch</groupId>
			<artifactId>pytorch-jni</artifactId>
			<version>${djl.pytorch.version}-${djl.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- PDF 리더 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-pdf-document-reader</artifactId>
		</dependency>

		<!-- 마크다운 리더 -->
		<dependency>
			<groupId>org.springframework.ai</groupId>
			<artifactId>spring-ai-markdown-document-reader</artifactId>
		</dependency>

		<!--
			MS Word(.docx) 문서 파싱용. EgovDocxDocumentReader 의 XWPFDocument/XWPFWordExtractor.

			POI 는 egovframe-rte-fdl-excel 의 전이 의존성으로도 들어오지만 그 경로를 쓰면 안 된다.
			fdl-excel 이 spring-webmvc + jakarta.servlet-api 를 함께 끌고 오는데,
			Spring Boot 의 WebApplicationType.deduceFromClasspath() 는 DispatcherServlet 이 보이면
			REACTIVE 판정을 포기하고 SERVLET 으로 떨어진다. 이 프로젝트는 WebFlux 라 서블릿 컨테이너가
			없으므로 기동이 실패한다. 'no ServletWebServerFactory bean defined' 가 뜬다.
			(그 밖에 spring-orm, mybatis, ibatis-sqlmap, commons-vfs2, jxls 도 함께 들어온다.)

			버전은 적지 않는다. parent 가 egovframe-rte-root 를 BOM 으로 import 하고 그 BOM 이
			poi·poi-ooxml 을 관리하므로, 실행환경이 정한 값을 그대로 받는다.
		-->
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
		</dependency>

		<!-- HWP 문서 파싱 (공공 행정문서 지원). 버전은 egovframe-rte-root 가 관리한다. -->
		<dependency>
			<groupId>kr.dogfoot</groupId>
			<artifactId>hwplib</artifactId>
		</dependency>

		<!-- HWPX 문서 파싱 (한글 .hwpx 형식, Apache-2.0). 버전은 위와 같다. -->
		<dependency>
			<groupId>kr.dogfoot</groupId>
			<artifactId>hwpxlib</artifactId>
		</dependency>

		<!-- JPA (DocumentMetadata 엔티티) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-logging</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<!-- PostgreSQL 드라이버 -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Springdoc OpenAPI (Swagger) for WebFlux -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
		</dependency>

		<!-- Lombok -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>

		<!-- Test -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<!--
		DJL PyTorch 네이티브의 classifier를 빌드 OS에 따라 결정한다.

		주의: 이 프로파일은 '빌드하는 머신'의 OS를 본다. 배포 대상이 다른 OS라면
		      반드시 명령행에서 직접 지정할 것 (명령행 -D가 프로파일 값보다 우선한다).
		          mvn package -Ddjl.pytorch.classifier=linux-x86_64
		      예: Windows에서 개발하고 Linux 컨테이너로 배포하는 경우.

		주의: 프로파일 조건은 OS만 보고 CPU 아키텍처는 보지 않는다. ARM64 Windows·ARM Linux에서
		      빌드하면 경고 없이 x86_64 네이티브가 들어가고 빌드도 성공한다. 그런 환경은
		      이 의존성을 제외하고 런타임 다운로드에 맡길 것(폐쇄망이면 불가).

		DJL 2.5.1이 제공하는 classifier: win-x86_64, linux-x86_64, osx-aarch64
		(linux-aarch64 / osx-x86_64는 제공되지 않는다. 해당 환경은 런타임 다운로드가 필요하다)
	-->
	<profiles>
		<profile>
			<id>djl-native-windows</id>
			<activation>
				<os><family>windows</family></os>
			</activation>
			<properties>
				<djl.pytorch.classifier>win-x86_64</djl.pytorch.classifier>
			</properties>
		</profile>
		<profile>
			<id>djl-native-linux</id>
			<activation>
				<os><name>linux</name></os>
			</activation>
			<properties>
				<djl.pytorch.classifier>linux-x86_64</djl.pytorch.classifier>
			</properties>
		</profile>
		<profile>
			<id>djl-native-mac</id>
			<activation>
				<os><family>mac</family></os>
			</activation>
			<properties>
				<djl.pytorch.classifier>osx-aarch64</djl.pytorch.classifier>
			</properties>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
